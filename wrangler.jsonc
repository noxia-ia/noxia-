{
  // Configuration Cloudflare Workers pour NOXIA (adaptateur OpenNext). Fichier à la RACINE du projet.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noxia",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  // nodejs_compat : indispensable (node:crypto, Buffer…). global_fetch_strictly_public : recommandé par OpenNext.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Optimisation des images de next/image (logo, visuels). Si wrangler refuse cette ligne, supprime ce bloc « images ».
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
  // Les clés (Supabase, Cloudflare AI, Pollinations, ElevenLabs…) ne vont JAMAIS ici :
  // dashboard Cloudflare > Workers & Pages > noxia > Settings > Variables and Secrets, ou : npx wrangler secret put NOM
}
