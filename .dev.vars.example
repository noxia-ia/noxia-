# Variables pour tester en local avec « npm run cf:preview » : copie ce fichier en « .dev.vars » (jamais commité).
# En production, les mêmes noms se saisissent dans Cloudflare > Variables and Secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
AGENT_PROVIDER=cloudflare
CODE_PROVIDER=cloudflare
IMAGE_PROVIDER=pollinations
VIDEO_PROVIDER=pollinations
MUSIC_PROVIDER=elevenlabs
STORAGE_PROVIDER=supabase-storage
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL_AGENT=
CLOUDFLARE_MODEL_CODE=
CLOUDFLARE_MODEL_STT=@cf/deepgram/nova-3
CLOUDFLARE_MODEL_TTS=@cf/deepgram/aura-1
CLOUDFLARE_VOICE=asteria
POLLINATIONS_API_KEY=
POLLINATIONS_MODEL_VIDEO=
POLLINATIONS_MODEL_IMAGE=flux
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
CHAT_ATTACHMENTS_ENABLED=true
CHAT_ATTACHMENT_MAX_MB=4
